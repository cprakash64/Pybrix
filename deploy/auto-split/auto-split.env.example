# Pybrix Auto Split service environment. Copy to /etc/cad-fixer/auto-split.env (mode 0600, root-owned).
# THIS FILE CONTAINS NO SECRET. The real key is entered on the server and nowhere else.

NODE_ENV=production
AUTO_SPLIT_PROVIDER=openai
# The provider key. Printable ASCII, no spaces. It is read once at start-up, held in a closure, and
# never logged, echoed, returned or placed in a response or a bundle.
OPENAI_API_KEY=

# Loopback only; nginx is the only way in.
AUTO_SPLIT_HOST=127.0.0.1
AUTO_SPLIT_PORT=8787
# Trust X-Real-IP, which nginx sets from the socket.
AUTO_SPLIT_TRUST_PROXY=1

# Cost and abuse guards (defaults shown): analyses per client per window, the window, concurrency.
AUTO_SPLIT_RATE_MAX=8
AUTO_SPLIT_RATE_WINDOW_SECONDS=3600
AUTO_SPLIT_CLIENT_CONCURRENT=1
AUTO_SPLIT_GLOBAL_CONCURRENT=6
# One bounded retry of a transient provider failure.
AUTO_SPLIT_PROVIDER_RETRIES=1
AUTO_SPLIT_PROVIDER_TIMEOUT_MS=150000
