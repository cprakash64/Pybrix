{
  "name": "cad-fixer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser application for repairing and preparing 3D printing meshes.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.js",
    "dev": "npm run dev --workspace @cadfixer/web",
    "prebuild": "npm run check:node",
    "build": "npm run build --workspace @cadfixer/web",
    "release:build": "node scripts/build-release-artifact.mjs",
    "release:verify": "vitest run scripts/hostinger-deployment.test.ts",
    "release:check": "npm run verify && npm run test:e2e && npm run test:e2e:harness && npm run test:e2e:timing",
    "monitor:production": "node scripts/monitor-production.mjs",
    "preview": "npm run preview --workspace @cadfixer/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench:stl": "vitest run --config vitest.bench.config.ts",
    "preverify": "npm run check:node",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "bench:topology": "vitest run --config vitest.bench.config.ts scripts/topology.bench-suite.ts",
    "bench:pipeline": "vitest run --config vitest.bench.config.ts scripts/pipeline.bench-suite.ts",
    "bench:document": "vitest run --config vitest.bench.config.ts scripts/document.bench-suite.ts",
    "bench:repair-browser": "CADFIXER_BROWSER_BENCH=1 playwright test e2e/repair-benchmark.spec.ts --reporter=list",
    "test:e2e:timing": "playwright test --config playwright.timing.config.ts",
    "test:e2e:harness": "playwright test --config playwright.harness.config.ts",
    "test:e2e:rc": "playwright test --config playwright.rc.config.ts",
    "bench:formats": "vitest run --config vitest.bench.config.ts scripts/format-import.bench-suite.ts",
    "bench:export": "vitest run --config vitest.bench.config.ts scripts/format-export.bench-suite.ts",
    "qualify:obj-export": "node scripts/obj-export.qualify.mjs",
    "qualify:obj-chunks": "node scripts/obj-chunks.qualify.mjs",
    "bench:hole-fill": "vitest run --config vitest.bench.config.ts scripts/hole-fill.bench-suite.ts",
    "bench:split": "vitest run --config vitest.bench.config.ts scripts/split-performance.bench-suite.ts",
    "bench:texture": "vitest run --config vitest.bench.config.ts scripts/texture-performance.bench-suite.ts",
    "bench:large-entry": "vitest run --config vitest.bench.config.ts scripts/large-entry.bench-suite.ts",
    "qualify:chromium-memory": "node scripts/chromium-memory.qualify.mjs",
    "bench:resource-model": "vitest run --config vitest.bench.config.ts scripts/resource-model.bench-suite.ts",
    "qualify:stl-footprint": "node scripts/stl-footprint.qualify.mjs",
    "qualify:import-phases": "node scripts/import-phases.qualify.mjs",
    "qualify:streaming-import": "node scripts/streaming-import.qualify.mjs",
    "bench:boundary-listing": "vitest run --config vitest.bench.config.ts scripts/boundary-listing.bench-suite.ts",
    "bench:boundary-fill": "vitest run --config vitest.bench.config.ts scripts/boundary-fill.bench-suite.ts",
    "qualify:boundary-fill": "node scripts/boundary-fill.qualify.mjs",
    "qualify:real-model-fill": "vitest run --config vitest.bench.config.ts scripts/real-model-fill.bench-suite.ts",
    "qualify:real-model": "node scripts/real-model.qualify.mjs",
    "qualify:threemf-corpus": "vitest run --config vitest.bench.config.ts scripts/threemf-corpus.suite.ts",
    "qualify:interop-corpus": "vitest run --config vitest.bench.config.ts scripts/interop-corpus.suite.ts",
    "qualify:streaming-corpus": "vitest run --config vitest.bench.config.ts scripts/streaming-corpus.suite.ts",
    "qualify:repair-core-06a": "vitest run --config vitest.bench.config.ts scripts/repair-core-06a-qualify.bench-suite.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
